<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           focusTraversable="true"
           fx:controller="javafxfrontend.controller.LoginController"
           stylesheets="@styles.css">

    <VBox styleClass="card" spacing="15" alignment="CENTER"
          maxWidth="450" maxHeight="550">

        <Label text="Вход в систему" styleClass="h3" style="-fx-padding: 0 0 10 0;"/>

        <TextField fx:id="loginField" promptText="Логин" styleClass="form-control"/>

        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <PasswordField fx:id="passwordField" promptText="Пароль" styleClass="form-control" maxWidth="Infinity"/>
            <TextField fx:id="visiblePasswordField" promptText="Пароль" styleClass="form-control" maxWidth="Infinity" visible="false" managed="false"/>
            <Button text="👁" onAction="#togglePassword"
                    style="-fx-background-color: transparent; -fx-text-fill: #6c757d; -fx-cursor: hand; -fx-font-size: 16px; -fx-padding: 0 15 0 0;"/>
        </StackPane>

        <Button fx:id="loginButton" text="Войти" onAction="#handleLogin"
                styleClass="main-button" maxWidth="Infinity"/>

        <Label fx:id="errorLabel" visible="false" managed="false" styleClass="text-danger"/>

        <Button text="Нет аккаунта? Зарегистрироваться" onAction="#goToRegistration"
                style="-fx-background-color: transparent; -fx-text-fill: #0d6efd; -fx-cursor: hand; -fx-font-size: 13px; -fx-underline: true;"/>
    </VBox>
</StackPane>