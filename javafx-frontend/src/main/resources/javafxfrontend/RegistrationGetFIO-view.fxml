<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="javafxfrontend.controller.Step2RegistrationController"
           stylesheets="@styles.css">

    <VBox styleClass="card" spacing="15" alignment="CENTER" maxWidth="450">

        <Label text="Ваши ФИО" styleClass="h3"/>

        <TextField fx:id="LastName" promptText="Фамилия" styleClass="form-control"/>
        <TextField fx:id="Name" promptText="Имя" styleClass="form-control"/>
        <TextField fx:id="Patronymic" promptText="Отчество" styleClass="form-control"/>

        <Button fx:id="registerButton" text="Зарегистрироваться" onAction="#handleRegistration"
                styleClass="main-button" maxWidth="Infinity"/>

        <Button text="Назад" onAction="#goBack"
                styleClass="btn-secondary" maxWidth="Infinity"/>

        <Label fx:id="errorLabel" visible="false" managed="false" styleClass="text-danger"/>
    </VBox>
</StackPane>